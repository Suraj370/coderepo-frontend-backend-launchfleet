{
  "description": "Golden vectors proving the backend's evaluation semantics (Phases 1-4: disabled -> targeting rules (priority, AND-combination, segments) -> rollout -> default, plus RolloutAssigner's SHA-256 bucketing) and the SDK's FlagEvaluator (Phase 5) select the identical variant for the identical (configuration, evaluation context) pair. Consumed by both backend/src/test/java/.../EvaluationGoldenVectorTest.java (a test-only reference evaluator built from real backend domain objects: Condition/TargetingRule/Segment/Rollout/RolloutAssigner/FeatureFlagConfig) and sdk/src/test/java/.../BackendGoldenVectorCompatibilityTest.java (the production FlagEvaluator). 'flag not found' is intentionally excluded: it is a snapshot-lookup miss with no backend-side analogue to compare against, and is already covered by FlagEvaluatorTest.unknownFlagReturnsFlagNotFound.",
  "scenarios": [
    {
      "name": "disabled_flag_bypasses_targeting_and_rollout",
      "environmentId": "env-1",
      "flagKey": "checkout",
      "segments": [],
      "flag": {
        "enabled": false,
        "defaultVariant": { "id": "v-off", "key": "off", "value": false },
        "variants": [ { "id": "v-off", "key": "off", "value": false }, { "id": "v-on", "key": "on", "value": true } ],
        "targetingRules": [
          { "id": "r1", "priority": 0, "variantId": "v-on", "conditions": [ { "type": "USER_KEY", "attribute": null, "operator": "EQUALS", "values": ["alice"] } ] }
        ],
        "rollout": { "allocations": [ { "variantId": "v-on", "percentage": 10000 } ] }
      },
      "context": { "userKey": "alice", "attributes": {} },
      "expectedVariantKey": "off"
    },
    {
      "name": "default_evaluation_no_rules_no_rollout",
      "environmentId": "env-1",
      "flagKey": "checkout",
      "segments": [],
      "flag": {
        "enabled": true,
        "defaultVariant": { "id": "v-off", "key": "off", "value": false },
        "variants": [ { "id": "v-off", "key": "off", "value": false }, { "id": "v-on", "key": "on", "value": true } ],
        "targetingRules": [],
        "rollout": null
      },
      "context": { "userKey": "bob", "attributes": {} },
      "expectedVariantKey": "off"
    },
    {
